# ==========================================
# A-Yong Solar Video WebApp 运行环境配置文件
# ==========================================

# 服务基础配置
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ==========================================
# ★ Cloudflare R2 对象存储配置 (3个核心凭证)
# ==========================================
# 1. Cloudflare 账户 ID (在 Cloudflare 概览页面右下角 "Account ID")
CF_ACCOUNT_ID=76a15b9c1f33264e46cab2d918e3621c

# 2. R2 API 令牌访问密钥 ID (Access Key ID)
CF_R2_ACCESS_KEY_ID=3bcbaa0f5907445d25feaa6c2f783ead

# 3. R2 API 令牌机密访问密钥 (Secret Access Key)
CF_R2_SECRET_ACCESS_KEY=0f2647d8f893e96b6e67ff71d545652bd701113d7840b1c29e499a7d968f7151

# 4. R2 存储桶名称
CF_R2_BUCKET=video

# 5. R2 公网访问域名
CF_R2_PUBLIC_DOMAIN=pub-181ed1de566e43d8947046a376d951a9.r2.dev

# ==========================================
# 云端算力与语音合成配置 (阶段二预留)
