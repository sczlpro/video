# ==========================================
# A-Yong Solar Video WebApp 运行环境配置文件
# ==========================================

# 服务基础配置
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# ==========================================
# ★ Cloudflare R2 对象存储配置 (3个核心凭证)
# ==========================================
# 1. Cloudflare 账户 ID (在 Cloudflare 控制台右侧侧边栏查看)
CF_ACCOUNT_ID=

# 2. R2 API 令牌访问密钥 ID (Access Key ID)
CF_R2_ACCESS_KEY_ID=

# 3. R2 API 令牌机密访问密钥 (Secret Access Key)
CF_R2_SECRET_ACCESS_KEY=

# 4. R2 存储桶名称 (默认为 ayong-solar-video)
CF_R2_BUCKET=ayong-solar-video

# 5. R2 公网访问域名 (在 R2 存储桶设置 -> 开启公开访问，如 https://pub-xxxx.r2.dev 或自定义域名)
CF_R2_PUBLIC_DOMAIN=

# ==========================================
# 云端算力与语音合成配置 (阶段二预留)
# ==========================================
# AutoDL 算力平台 API Key (工作流: minimax_h3_zm_u24)
AUTODL_API_KEY=

# 阿里百炼 CosyVoice 语音合成 Key
DASHSCOPE_API_KEY=
